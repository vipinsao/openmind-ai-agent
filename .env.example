# Copy to .env.local:  cp .env.example .env.local
#
# Google AI Studio key — free tier, no credit card:
#   https://aistudio.google.com/app/apikey
# The route accepts GOOGLE_API_KEY as well, because that is what this project's
# hosting environment was originally configured with.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.0-flash.
# gemini-1.5-flash-latest, the previous default, has been retired.
GEMINI_MODEL=
